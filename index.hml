<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GameShelf - Dashboard</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <h1>GameShelf 🎮</h1>
        <nav>
            <a href="index.html">Dashboard</a>
            <a href="colecao.html">Minha Coleção</a>
        </nav>
    </header>

    <main>
        <h2>Resumo da Coleção</h2>
        <div class="grid-jogos" style="margin-top: 20px;">
            <div class="card">
                <h3>Total de Jogos</h3>
                <p id="total-jogos" style="font-size: 2.5em; font-weight: bold;">0</p>
            </div>
            <div class="card">
                <h3>Média de Notas</h3>
                <p id="media-notas" style="font-size: 2.5em; font-weight: bold;">0.0</p>
            </div>
            <div class="card">
                <h3>Jogos Zerados</h3>
                <p id="total-zerados" style="font-size: 2.5em; font-weight: bold;">0</p>
            </div>
        </div>
    </main>

    <script src="storage.js"></script>
    <script>
        function carregarResumo() {
            const jogos = carregarJogos(); 
            
            // Total de Jogos
            document.getElementById('total-jogos').innerText = jogos.length;
            
            // Total de Jogos Zerados usando filtro em vetor
            const zerados = jogos.filter(jogo => jogo.status === 'Zerado').length;
            document.getElementById('total-zerados').innerText = zerados;

            // Cálculo da média de notas
            if (jogos.length > 0) {
                const somaNotas = jogos.reduce((acumulador, jogo) => acumulador + parseFloat(jogo.nota), 0);
                const media = (somaNotas / jogos.length).toFixed(1);
                document.getElementById('media-notas').innerText = media;
            }
        }

        // Executa a função assim que a página é carregada
        window.onload = carregarResumo;
    </script>
</body>
</html>
